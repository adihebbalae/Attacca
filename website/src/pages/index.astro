<!-- ─── TOAST ─────────────────────────────────────────────── -->
<div id="toast">Copied to clipboard</div>

<script type="application/json" id="skills-data" set:html={JSON.stringify(SKILLS)}></script>

<script>
  const skillsData = JSON.parse(document.getElementById('skills-data').textContent);
  const skillsByCmd = {};
  skillsData.forEach((s) => { skillsByCmd[s.cmd] = s; });

  function copyInstall() {
    const cmd = [
      '/plugin marketplace add adihebbalae/Attacca',
      '/plugin install attacca-core@attacca',
      '/plugin install attacca-security@attacca',
      '/plugin install attacca-init@attacca',
    ].join('\n');

    navigator.clipboard.writeText(cmd).then(() => {
      const t = document.getElementById('toast');
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 2200);
    });
  }
  document.getElementById('copy-install-btn').addEventListener('click', copyInstall);

  // ── Live terminal ──────────────────────────────────────
  const output = document.getElementById('term-output');
  const input = document.getElementById('term-input');
  const suggestBox = document.getElementById('term-suggest');
  const history = [];
  let historyIdx = -1;
  let activeSuggestIdx = -1;
  let lastSkill = null;

  function appendLine(text, cls) {
    const div = document.createElement('div');
    div.className = 'term-line ' + (cls || '');
    div.textContent = text;
    output.appendChild(div);
    output.scrollTop = output.scrollHeight;
  }

  function appendEcho(text) {
    const div = document.createElement('div');
    div.className = 'term-line cmd-echo';
    const prompt = document.createElement('span');
    prompt.className = 'prompt';
    prompt.textContent = '›';
    div.appendChild(prompt);
    div.appendChild(document.createTextNode(text));
    output.appendChild(div);
    output.scrollTop = output.scrollHeight;
  }

  function appendAgent(text) {
    appendLine('◈ agent  ' + text, 'agent');
  }

  function runCommand(raw) {
    const trimmed = raw.trim();
    if (!trimmed) return;
    appendEcho(trimmed);
    history.push(trimmed);
    historyIdx = history.length;

    const name = trimmed.replace(/^\//, '').toLowerCase();

    if (name === 'clear') {
      output.innerHTML = '';
      lastSkill = null;
      return;
    }
    if (name === 'help') {
      appendLine('All commands:', 'resp');
      skillsData.forEach((s) => appendLine('  /' + s.cmd + '  [' + s.plugin + ']', 'resp'));
      return;
    }

    const skill = skillsByCmd[name];
    if (skill) {
      appendLine('[' + skill.plugin + ']', 'resp plugin-tag');
      appendLine(skill.desc, 'resp');
      appendAgent(skill.reply);
      lastSkill = skill;
      return;
    }

    // Not a recognized command. If an agent is "mid-conversation", redirect to install.
    if (lastSkill) {
      appendAgent(
        "that's as far as the preview goes — the real /" + lastSkill.cmd + " runs inside your own codebase. install " + lastSkill.plugin + ":\n" +
        "  /plugin marketplace add adihebbalae/Attacca\n" +
        "  /plugin install " + lastSkill.plugin + "@attacca"
      );
      return;
    }

    const matches = Object.keys(skillsByCmd).filter((c) => c.includes(name));
    if (matches.length) {
      appendLine('Unknown command. Did you mean: ' + matches.slice(0, 4).map((m) => '/' + m).join(', ') + '?', 'err');
    } else {
      appendLine('Not a command yet — try /tdd, or /help to see everything.', 'err');
    }
  }

  function updateSuggestions() {
    const val = input.value.replace(/^\//, '').toLowerCase();
    suggestBox.innerHTML = '';
    activeSuggestIdx = -1;
    if (!val) { suggestBox.classList.remove('show'); return; }
    const matches = Object.keys(skillsByCmd).filter((c) => c.startsWith(val)).slice(0, 6);
    if (!matches.length) { suggestBox.classList.remove('show'); return; }
    matches.forEach((m) => {
      const item = document.createElement('div');
      item.className = 'term-suggest-item';
      item.textContent = '/' + m;
      item.addEventListener('mousedown', (e) => {
        e.preventDefault();
        input.value = '/' + m;
        suggestBox.classList.remove('show');
        input.focus();
      });
      suggestBox.appendChild(item);
    });
    suggestBox.classList.add('show');
  }

  input.addEventListener('input', updateSuggestions);

  input.addEventListener('keydown', (e) => {
    const items = suggestBox.querySelectorAll('.term-suggest-item');
    if (e.key === 'Enter') {
      e.preventDefault();
      if (activeSuggestIdx >= 0 && items[activeSuggestIdx]) {
        input.value = items[activeSuggestIdx].textContent;
      }
      runCommand(input.value);
      input.value = '';
      suggestBox.classList.remove('show');
    } else if (e.key === 'Tab') {
      if (items.length) {
        e.preventDefault();
        input.value = items[0].textContent;
        suggestBox.classList.remove('show');
      }
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (items.length) {
        activeSuggestIdx = Math.min(activeSuggestIdx + 1, items.length - 1);
        items.forEach((it, i) => it.classList.toggle('active', i === activeSuggestIdx));
      } else if (history.length) {
        historyIdx = Math.min(historyIdx + 1, history.length);
        input.value = history[historyIdx] || '';
      }
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (items.length) {
        activeSuggestIdx = Math.max(activeSuggestIdx - 1, 0);
        items.forEach((it, i) => it.classList.toggle('active', i === activeSuggestIdx));
      } else if (history.length) {
        historyIdx = Math.max(historyIdx - 1, 0);
        input.value = history[historyIdx] || '';
      }
    } else if (e.key === 'Escape') {
      suggestBox.classList.remove('show');
    }
  });

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.term-input-row')) suggestBox.classList.remove('show');
  });

  document.querySelectorAll('.chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      runCommand('/' + chip.dataset.cmd);
      input.focus();
    });
  });

  appendLine('Type a command and press Enter — try /tdd or /security-audit. Reply again and the agent will point you to the real thing.', 'resp hint');

  // ── Plugin skill modal ─────────────────────────────────
  const modal = document.getElementById('skill-modal');
  const modalTitle = document.getElementById('modal-title');
  const modalSub = document.getElementById('modal-sub');
  const modalBody = document.getElementById('modal-body');

  function openPluginModal(pluginName) {
    const skills = skillsData.filter((s) => s.plugin === pluginName);
    modalTitle.textContent = pluginName;
    modalSub.textContent = skills.length + ' skills';
    modalBody.innerHTML = '';
    skills.forEach((s) => {
      const div = document.createElement('div');
      div.className = 'modal-skill';
      const code = document.createElement('code');
      code.textContent = '/' + s.cmd;
      const p = document.createElement('p');
      p.textContent = s.desc;
      div.appendChild(code);
      div.appendChild(p);
      modalBody.appendChild(div);
    });
    modal.classList.add('show');
  }

  document.querySelectorAll('.plugin-card').forEach((card) => {
    card.addEventListener('click', () => openPluginModal(card.dataset.plugin));
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openPluginModal(card.dataset.plugin);
      }
    });
  });

  document.getElementById('modal-close').addEventListener('click', () => modal.classList.remove('show'));
  modal.addEventListener('click', (e) => { if (e.target === modal) modal.classList.remove('show'); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') modal.classList.remove('show'); });
</script>

</body>
