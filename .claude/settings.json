{
  "env": {
    "MAX_THINKING_TOKENS": "10000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/plugins/attacca-core/hooks/read-once.mjs\""
          }
        ]
      }
    ]
  }
}
